<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root_1x1"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background_compact"
    android:gravity="top"
    android:orientation="vertical"
    android:padding="7dp">

    <TextView
        android:id="@+id/status_1x1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="● LIVE"
        android:textColor="@color/live"
        android:textSize="9sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/line1_1x1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="IND  334/7"
        android:textColor="@color/text_primary"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/line2_1x1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="AUS  171"
        android:textColor="@color/text_secondary"
        android:layout_marginTop="3dp"
        android:textSize="11sp" />
</LinearLayout>
